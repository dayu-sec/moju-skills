{
  "name": "moju-extract",
  "version": "1.1.0",
  "display_name": "MoJu Extract",
  "description": "How to extract MoJu facts from Rust and Java projects. Covers current moju-code extract usage, Rust/Java annotation scanning, type mapping, field filtering, facts.json, and reverse-modeling handoff to moju/draft.",
  "author": "moju",
  "license": "MIT",
  "platforms": ["claude-code", "codex"],
  "categories": ["moju", "rust", "java", "extraction"],
  "triggers": {
    "keywords": [
      "moju extract",
      "moju rust extract",
      "moju java extract",
      "rust facts",
      "java facts",
      "rust moju annotations",
      "java moju annotations",
      "javaextractor",
      "moju-code extract rust",
      "moju-code extract java",
      "@MoJu annotation extract"
    ],
    "patterns": [
      "extract.*java.*moju",
      "extract.*rust.*moju",
      "java.*facts.*json",
      "rust.*facts.*json",
      "scan.*java.*annotations",
      "scan.*rust.*annotations",
      "moju.*extract"
    ]
  },
  "files": {
    "skill": "SKILL.md"
  }
}

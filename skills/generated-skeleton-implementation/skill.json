{
  "name": "generated-skeleton-implementation",
  "version": "2.0.0",
  "display_name": "Generated Skeleton Implementation",
  "description": "How to work inside Rust or Java skeletons produced by jumo-code generate. Covers reading order, Jumo 2.0 static/runtime model layout, runtime services, implementation discipline, annotations, config/storage bindings, and acceptance criteria.",
  "author": "jumo",
  "license": "MIT",
  "platforms": ["claude-code", "codex", "agents"],
  "categories": ["jumo", "implementation"],
  "triggers": {
    "keywords": [
      "jumo-code generate",
      "jumo generate",
      "generated skeleton",
      "domain package",
      "module split",
      "static runtime",
      "runtime service",
      "AI_TASKS.md",
      "skeleton implementation",
      "jumo-gen.json",
      "JUMO_MODEL.md",
      "binding.mju",
      "target.mju"
    ],
    "patterns": [
      "implement.*skeleton",
      "generated.*crate",
      "generated.*project",
      "jumo.*generate.*implement"
    ]
  },
  "files": {
    "skill": "SKILL.md"
  }
}
